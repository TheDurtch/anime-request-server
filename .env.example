# Database
DATABASE_URL=******localhost:5432/anime_requests?sslmode=disable

# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Session (currently unused; reserved for future cookie signing — optional)
SESSION_SECRET=change-me-to-a-random-secret-at-least-32-chars

# Web UI (set to false to run API-only)
WEBUI_ENABLED=true

# Trusted client-IP header set by your reverse proxy, used for login rate
# limiting. Leave empty to trust no forwarding headers (use the TCP peer addr).
# Examples: CF-Connecting-IP (Cloudflare), X-Forwarded-For (Caddy/Pangolin/nginx).
REAL_IP_HEADER=

# Secure flag on session cookies (default true). Set false only for local
# development over plain HTTP.
COOKIE_SECURE=true
